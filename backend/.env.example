# =============================================================
# Dark Video Pipeline V2 — Variáveis de Ambiente
# =============================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado ".env"
#    (sem o .example no nome)
# 2. Preencha suas chaves abaixo
# 3. NUNCA envie o .env para o GitHub (já está no .gitignore)
# =============================================================

# --- Módulo 1: Geração de Roteiro ---
# Crie sua chave grátis em: https://openrouter.ai/
OPENROUTER_API_KEY="sk-or-v1-sua_chave_aqui"

# --- Local LLM & Ollama / Braço 1 Settings ---
USE_OLLAMA=True
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
BRACO1_URL=http://localhost:8001
# LLM_PROVIDER: 'ollama' (direto porta 11434) ou 'braco1' (FastAPI do seu servidor local porta 8001)
LLM_PROVIDER=ollama

# --- Módulo 4: Coleta de Vídeos B-Roll ---
# Crie sua chave grátis em: https://www.pexels.com/api/
PEXELS_API_KEY="sua_chave_pexels_aqui"

# --- Módulo 4: Música de Fundo ---
# Crie sua chave grátis em: https://pixabay.com/api/docs/
PIXABAY_API_KEY="sua_chave_pixabay_aqui"

# --- Módulo 2: Voz (Opcional - apenas se quiser ElevenLabs premium) ---
# Deixe em branco para usar o Kokoro TTS local (gratuito)
# ELEVENLABS_API_KEY="sua_chave_elevenlabs_aqui"

# --- Sprint BÔNUS: Supabase (Viral Hunter + Cache B-Roll) ---
# Crie seu projeto grátis em: https://supabase.com/
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_KEY="sua_anon_key_aqui"
